{
  "name": "bun-elysia-modular-starter",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/app/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@whiskeysockets/baileys": "7.0.0-rc11",
    "bun-elysia-modular-starter": ".",
    "elysia": "1.4.28",
    "googleapis": "171.4.0",
    "groq-sdk": "^0.37.0",
    "pg": "8.21.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "25.9.0",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "bun-types": "1.3.14",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "typescript": "^5.9.3",
    "zod": "4.4.3"
  },
  "module": "src/index.js"
}
